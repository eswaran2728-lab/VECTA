# aa-ops (VECTA) — combined environment template.
#
# UPDATED: the app now runs on a fresh, dedicated Supabase project,
# "vecta-prod" (project ref zsxneokqulktgnccxgkz), created specifically for
# VECTA and populated by replaying the full migration sequence in
# supabase/migrations/ (AVSEC's schema, then ICMS's schema, then the unified
# role model and demo account roster). Point these vars at that project.
#
# AVSEC's original Supabase project (ddlctzbnqewubltcavkh) is retained
# separately, stripped back to its bare original AVSEC schema, and is no
# longer used by this app.

# --- Supabase (single shared project — vecta-prod, see note above) ---
NEXT_PUBLIC_SUPABASE_URL=https://zsxneokqulktgnccxgkz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key - SERVER ONLY. Never expose to the browser.
# Required by ICMS (user management/seeding) and AVSEC (admin create-account,
# which reads this same var — see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AVSEC's admin server action prefers a plain (non-NEXT_PUBLIC_) SUPABASE_URL
# over the inlined NEXT_PUBLIC_ var in some server-action bundles — same value
# as NEXT_PUBLIC_SUPABASE_URL above, without the NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://zsxneokqulktgnccxgkz.supabase.co

# --- App URL (ICMS: used in QR deep links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- ICMS: QR pass token signing ---
# Server-only secret used to sign QR pass tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_TOKEN_SECRET=YOUR_RANDOM_64_CHAR_HEX_SECRET

# --- AVSEC: transactional email (admin submission notices, OT approvals) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- AVSEC: SEC016 Smart Input paste-to-autofill ---
ANTHROPIC_API_KEY=

# --- Auth provider selection (Phase 1-4 migration) ---
# "supabase" (default, or unset) keeps today's email/password sign-in.
# "firebase" swaps in Google Workspace sign-in (Phase 3+). Both vars must
# be set to the SAME value — AUTH_PROVIDER is read server-side,
# NEXT_PUBLIC_AUTH_PROVIDER is its client-bundle-visible twin (lib/supabase/
# client.ts, the login page's GoogleSignInButton branch).
AUTH_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# --- Firebase (only needed once AUTH_PROVIDER=firebase — see AUTH-CONTRACT.md) ---
# From the Firebase console: Project settings -> General -> Your apps ->
# the registered web app's config. Not secrets — safe to expose to the
# browser, protected by Authorized domains, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Restricts the Google account picker to this Workspace domain (UX only —
# /api/auth/sync-claims re-checks server-side via AVSEC_WORKSPACE_DOMAIN
# below, which is the real check). Same value as AVSEC_WORKSPACE_DOMAIN.
NEXT_PUBLIC_AVSEC_WORKSPACE_DOMAIN=

# SERVER ONLY. The real, security-relevant Workspace-domain check that
# /api/auth/sync-claims performs before ever setting Firebase custom
# claims — a bypassed client-side hd hint cannot get past this.
AVSEC_WORKSPACE_DOMAIN=

# SERVER ONLY. Firebase console -> Project settings -> Service accounts ->
# Generate new private key. Base64-encode the downloaded JSON file before
# pasting here — never commit the raw JSON:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# SERVER ONLY. CaterLink's own origin — /api/auth/sync-claims only
# accepts cross-origin requests from exactly this origin (CORS), never a
# wildcard, since it's a token-bearing endpoint that mints Firebase
# custom claims.
CATERLINK_APP_URL=https://caterlink-ifc.vercel.app

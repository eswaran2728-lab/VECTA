NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL, without the prefix. Server-only — used by the
# Admin > User Management "Create account" server action instead of the NEXT_PUBLIC_ var,
# since Next.js's build-time inlining of NEXT_PUBLIC_ vars doesn't reliably reach Server
# Action bundles even though it works fine in Server Components.
SUPABASE_URL=
# Service role key (Supabase Dashboard -> Settings -> API). Server-only — required for
# Admin > User Management "Create account" (calls the Auth admin API). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ANTHROPIC_API_KEY=

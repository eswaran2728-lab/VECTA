# aa-ops (VECTA) — combined environment template.
#
# UPDATED: the app now runs against AVSEC's Supabase project (registered
# under the AirAsia email) as the single shared project — ICMS's tables
# (users, transactions, part_a/b/c/d, vendor_transactions, etc.) have been
# migrated into it via supabase/migrations/icms/*.sql, applied directly to
# that project. Point these vars at AVSEC's project (ddlctzbnqewubltcavkh).
# ICMS's original Supabase project is no longer used by this app.

# --- Supabase (single shared project — AVSEC's, see note above) ---
NEXT_PUBLIC_SUPABASE_URL=https://ddlctzbnqewubltcavkh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key - SERVER ONLY. Never expose to the browser.
# Required by ICMS (user management/seeding) and AVSEC (admin create-account,
# which reads this same var — see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AVSEC's admin server action prefers a plain (non-NEXT_PUBLIC_) SUPABASE_URL
# over the inlined NEXT_PUBLIC_ var in some server-action bundles — same value
# as NEXT_PUBLIC_SUPABASE_URL above, without the NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://ddlctzbnqewubltcavkh.supabase.co

# --- App URL (ICMS: used in QR deep links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- ICMS: QR pass token signing ---
# Server-only secret used to sign QR pass tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_TOKEN_SECRET=YOUR_RANDOM_64_CHAR_HEX_SECRET

# --- AVSEC: transactional email (admin submission notices, OT approvals) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- AVSEC: SEC016 Smart Input paste-to-autofill ---
ANTHROPIC_API_KEY=

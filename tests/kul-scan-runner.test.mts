import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import{frozenSql,MIGRATIONS,PRE_COUNT,LAST_PRE,RUNNER_BRANCH,LIVE_PHRASE}from'../scripts/staging/apply-kul-caterlink-scan-migration.mjs';
test('KUL runner freezes one forward migration and the exact staging pre-state',()=>{assert.equal(PRE_COUNT,107);assert.equal(LAST_PRE,'20261130000004');assert.equal(MIGRATIONS.length,1);assert.equal(MIGRATIONS[0].version,'20261130000005');assert.equal(RUNNER_BRANCH,'fix/caterlink-kul-maa-scanning');assert.match(LIVE_PHRASE,/STAGING ddlctzbnqewubltcavkh$/);assert.match(frozenSql(),/KUL - MAA/);});
test('KUL runner keeps explicit backup, git, environment, transactional and rollback gates',()=>{const s=fs.readFileSync(path.resolve(import.meta.dirname,'../scripts/staging/apply-kul-caterlink-scan-migration.mjs'),'utf8');for(const term of ['gitGates({expectedBase:head','environmentGates()','decryptBackupPayload','3600000','isolation level serializable','pass(false)','Rollback did not restore state','if(live)','await pass(true)','role authenticated','has_function_privilege'])assert.ok(s.includes(term),term);assert.ok(s.indexOf('const dry=await pass(false)')<s.indexOf('await pass(true)'));});

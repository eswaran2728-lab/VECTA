# Staging test-account provisioning (scripts/staging/) -- credentials and
# recovery manifests must never be committed, regardless of where the
# operator points --credentials-file/--manifest-file. These patterns are
# defense in depth; the scripts themselves default to writing OUTSIDE this
# repository entirely.
*.staging-credentials.json
*.staging-manifest.json
staging-credentials*.json
staging-manifest*.json

# Staging backups (scripts/staging/backup.mjs) -- real Auth-user
# inventories and real Storage object bytes, even though volumes are
# currently tiny. Defense in depth; the script's default output path is
# os.tmpdir(), outside this repository entirely.
vecta-staging-backups/
*.staging-backup/
auth-users-inventory.json
storage-inventory.json
